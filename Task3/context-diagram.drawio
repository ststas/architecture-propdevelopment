<mxfile host="Electron">
  <diagram name="Контекст: умный дом" id="ctx-smart-home">
    <mxGraphModel dx="1600" dy="1993" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ctx-title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="Диаграмма контекста (C4): новые функции «Умного дома» для собственников" vertex="1">
          <mxGeometry height="40" width="720" x="225" y="-810" as="geometry" />
        </mxCell>
        <object placeholders="1" c4Name="Собственник" c4Type="Person" c4Description="Использует мобильное приложение PropDevelopment: удалённо открывает дверь/шлагбаум, получает вызовы домофона и уведомления о событиях доступа." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#cccccc&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-owner">
          <mxCell parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1">
            <mxGeometry height="180" width="200" x="680" y="-760" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Гость / Посетитель" c4Type="Person" c4Description="Звонит в домофон при визите к собственнику или подъезжает к шлагбауму на автомобиле. Не имеет учётной записи в системах PropDevelopment." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#cccccc&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-guest">
          <mxCell parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1">
            <mxGeometry height="180" width="200" x="200" y="-220" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="PropDevelopment" c4Type="Software System" c4Description="Платформа компании для клиентов и собственников. В контексте этой диаграммы — модуль управления умным домом (интеллектуальный домофон и шлагбаум) для собственников." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-propdev">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0B4884;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="160" width="380" x="590" y="-480" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Платформа умного дома (партнёр)" c4Type="Software System" c4Description="Интеллектуальный домофон (видеозвонок + биометрическое распознавание лиц) и интеллектуальный шлагбаум (распознавание номеров). Управляет физическими устройствами на объектах." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#cccccc&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ctx-smarthome">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="140" width="340" x="610" y="-180" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="ctx-e1" edge="1" parent="1" source="ctx-owner" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;align=center;" target="ctx-propdev" value="Управляет умным домом: открывает дверь/шлагбаум удалённо,&lt;div&gt;получает вызовы и уведомления о событиях доступа&lt;/div&gt;&lt;div&gt;[Mobile app, REST/WS]&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ctx-e2" edge="1" parent="1" source="ctx-propdev" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;align=center;" target="ctx-smarthome" value="Передаёт команды доступа и список разрешённых лиц/автомобилей;&lt;div&gt;получает события распознавания и вызовы&lt;/div&gt;&lt;div&gt;[API, защищённый канал]&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ctx-e3" edge="1" parent="1" source="ctx-guest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;align=center;" target="ctx-smarthome" value="Звонит в домофон /&lt;div&gt;подъезжает к шлагбауму&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.1429" as="geometry">
